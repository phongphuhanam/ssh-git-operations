#compdef ssh-gh-remote-push ssh-gh-remote-pull ssh-gh-remote-fetch ssh-gh-remote-clone scp-git-aware

# Completion for ssh-git-operations: SSH host completion + scp-style remote paths.
# Reuses zsh's own _ssh_hosts / _remote_files (the same helpers scp's completion
# uses internally) instead of dispatching through _ssh, since _ssh only handles
# $service values it recognizes (ssh, scp, ...) and ours isn't one of them.
_ssh-git-operations() {
    local ret=1

    case "$words[1]" in
        ssh-gh-remote-push|ssh-gh-remote-pull|ssh-gh-remote-fetch|ssh-gh-remote-clone)
            if [ $CURRENT -eq 2 ]; then
                if compset -P 1 '[^./][^/]#:'; then
                    _remote_files -- ssh && ret=0
                elif compset -P 1 '*@'; then
                    _wanted hosts expl 'remote host name' _ssh_hosts -S '' && ret=0
                else
                    _wanted hosts expl 'remote host name' _ssh_hosts -r: -S: && ret=0
                fi
            elif [ $CURRENT -eq 3 ]; then
                _files
                ret=0
            fi
            ;;
        scp-git-aware)
            if [ $CURRENT -eq 2 ]; then
                _wanted hosts expl 'remote host name' _ssh_hosts && ret=0
            fi
            ;;
    esac

    return $ret
}

_ssh-git-operations
