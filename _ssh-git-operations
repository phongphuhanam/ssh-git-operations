#compdef ssh-gh-remote-push ssh-gh-remote-pull ssh-gh-remote-fetch scp-git-aware

# Completion for ssh-git-operations using scp-style syntax
_ssh-git-operations() {
    case "$words[1]" in
        ssh-gh-remote-push|ssh-gh-remote-pull|ssh-gh-remote-fetch)
            # Use _ssh to handle remote path completion (like scp does)
            # Syntax: command user@host:/path with colon
            _ssh
            ;;
        scp-git-aware)
            # Just complete SSH host
            local hosts=($(grep "^Host " ~/.ssh/config 2>/dev/null | awk '{print $2}' | grep -v '^\*'))
            _arguments "1:SSH host:($hosts)"
            ;;
    esac
}

_ssh-git-operations
