#compdef ssh-gh-remote-push ssh-gh-remote-pull ssh-gh-remote-fetch scp-git-aware

# Completion for ssh-git-operations plugin

_ssh_git_operations() {
    local -a commands

    case "$service" in
        ssh-gh-remote-push)
            _description "Push current branch to GitHub over SSH"
            _arguments \
                '1:SSH host:_ssh_git_hosts' \
                '2:Repository path (default: current):_files -/'
            ;;
        ssh-gh-remote-pull)
            _description "Pull current branch from GitHub over SSH"
            _arguments \
                '1:SSH host:_ssh_git_hosts' \
                '2:Repository path (default: current):_files -/'
            ;;
        ssh-gh-remote-fetch)
            _description "Fetch from GitHub over SSH"
            _arguments \
                '1:SSH host:_ssh_git_hosts' \
                '2:Repository path (default: current):_files -/'
            ;;
        scp-git-aware)
            _description "Find git repositories on remote machine"
            _arguments \
                '1:SSH host:_ssh_git_hosts'
            ;;
    esac
}

# Complete SSH hosts from ~/.ssh/config
_ssh_git_hosts() {
    local hosts
    if [ -f ~/.ssh/config ]; then
        hosts=($(grep -E '^Host ' ~/.ssh/config | awk '{print $2}' | grep -v '^*'))
        compadd -a hosts
    fi
}

_ssh_git_operations "$@"
