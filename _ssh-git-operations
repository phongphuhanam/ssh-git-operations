#compdef ssh-gh-remote-push ssh-gh-remote-pull ssh-gh-remote-fetch scp-git-aware

# Fast completion for ssh-git-operations (SSH hosts only - no slow remote queries)
_ssh-git-operations() {
    local hosts=($(grep "^Host " ~/.ssh/config 2>/dev/null | awk '{print $2}' | grep -v '^\*'))

    case "$words[1]" in
        ssh-gh-remote-push|ssh-gh-remote-pull|ssh-gh-remote-fetch)
            # Only complete SSH host (instant)
            # For paths, user types directly (no completion delay)
            _arguments \
                "1:SSH host:($hosts)" \
                "2:repository path:"
            ;;
        scp-git-aware)
            _arguments "1:SSH host:($hosts)"
            ;;
    esac
}

_ssh-git-operations
